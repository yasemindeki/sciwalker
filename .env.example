# AWS credentials for Amazon Bedrock
# Option 1: standard AWS credentials (recommended)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key

# Option 2: Bedrock API key (simplest for local dev)
# AWS_BEARER_TOKEN_BEDROCK=your_bedrock_api_key

# Bedrock model ID — confirm this is enabled in your AWS account
# Visit: AWS Console → Amazon Bedrock → Model access
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5
